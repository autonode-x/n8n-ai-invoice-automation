    {
      "parameters": {
        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n\n<meta charset=\"UTF-8\">\n\n<meta name=\"viewport\"\ncontent=\"width=device-width, initial-scale=1.0\">\n\n<title>\nInvoice | AutoNode Technologies\n</title>\n\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap\"\nrel=\"stylesheet\">\n\n<style>\n\n*{\nmargin:0;\npadding:0;\nbox-sizing:border-box;\n}\n\nbody{\n\nfont-family:'Inter',Arial,sans-serif;\n\nbackground:#eef3f7;\n\npadding:40px;\n\ncolor:#2d3436;\n\n}\n\n.invoice{\n\nwidth:900px;\n\nmargin:auto;\n\nbackground:#fff;\n\nborder-radius:16px;\n\noverflow:hidden;\n\nbox-shadow:\n0 15px 45px rgba(0,0,0,.12);\n\n}\n.header{\n\nbackground:linear-gradient(\n135deg,\n#0F6E56,\n#1D9E75\n);\n\ncolor:#fff;\n\npadding:45px;\n\ndisplay:flex;\n\njustify-content:space-between;\n\nalign-items:flex-start;\n\n}\n\n.company{\n\nwidth:60%;\n\n}\n\n.company h1{\n\nfont-size:36px;\n\nfont-weight:700;\n\nmargin-bottom:10px;\n\nletter-spacing:.5px;\n\n}\n\n.company .tagline{\n\nfont-size:15px;\n\nopacity:.95;\n\nmargin-bottom:20px;\n\n}\n\n.company p{\n\nfont-size:14px;\n\nmargin:6px 0;\n\nline-height:1.6;\n\n}\n\n.invoice-info{\n\ntext-align:right;\n\n}\n\n.invoice-info h2{\n\nfont-size:42px;\n\nletter-spacing:2px;\n\nmargin-bottom:20px;\n\n}\n\n.badge{\n\ndisplay:inline-block;\n\nbackground:#ffffff22;\n\npadding:8px 18px;\n\nborder-radius:30px;\n\nfont-size:13px;\n\nfont-weight:600;\n\nmargin-bottom:20px;\n\n}\n\n.invoice-info p{\n\nfont-size:14px;\n\nmargin:8px 0;\n\n}\n\n.section{\n\npadding:40px;\n\n}\n\n.row{\n\ndisplay:flex;\n\njustify-content:space-between;\n\ngap:40px;\n\nmargin-bottom:40px;\n\n}\n\n.box{\n\nflex:1;\n\nbackground:#fafafa;\n\npadding:25px;\n\nborder-radius:12px;\n\nborder:1px solid #ececec;\n\n}\n\n.box h3{\n\ncolor:#0F6E56;\n\nfont-size:18px;\n\nmargin-bottom:18px;\n\nborder-bottom:2px solid #1D9E75;\n\npadding-bottom:8px;\n\ndisplay:inline-block;\n\n}\n\n.box p{\n\nfont-size:15px;\n\nmargin:10px 0;\n\nline-height:1.7;\n\n}\ntable{\n\nwidth:100%;\n\nborder-collapse:collapse;\n\nmargin-top:20px;\n\nborder-radius:12px;\n\noverflow:hidden;\n\n}\n\nthead{\n\nbackground:#0F6E56;\n\ncolor:#fff;\n\n}\n\nth{\n\npadding:16px;\n\nfont-size:15px;\n\nfont-weight:600;\n\ntext-align:left;\n\n}\n\ntd{\n\npadding:16px;\n\nfont-size:15px;\n\nborder-bottom:1px solid #ececec;\n\n}\n\ntbody tr:nth-child(even){\n\nbackground:#fafafa;\n\n}\n\ntbody tr:hover{\n\nbackground:#f2fbf8;\n\ntransition:.25s;\n\n}\n\n.amount{\n\ntext-align:right;\n\nfont-weight:600;\n\n}\n\n.summary{\n\nwidth:360px;\n\nmargin-left:auto;\n\nmargin-top:35px;\n\nbackground:#fafafa;\n\nborder:1px solid #e7e7e7;\n\nborder-radius:12px;\n\npadding:22px;\n\n}\n\n.summary table{\n\nmargin:0;\n\n}\n\n.summary td{\n\npadding:12px 0;\n\nborder:none;\n\nfont-size:15px;\n\n}\n\n.summary tr:not(:last-child){\n\nborder-bottom:1px dashed #ddd;\n\n}\n\n.summary .label{\n\nfont-weight:500;\n\ncolor:#555;\n\n}\n\n.summary .value{\n\ntext-align:right;\n\nfont-weight:600;\n\n}\n\n.total-row{\n\nborder-top:2px solid #1D9E75;\n\n}\n\n.total-row td{\n\npadding-top:18px;\n\nfont-size:22px;\n\nfont-weight:700;\n\ncolor:#0F6E56;\n\n}\n.payment{\n\nmargin-top:45px;\n\npadding:28px;\n\nbackground:#F5FBF9;\n\nborder-left:6px solid #1D9E75;\n\nborder-radius:10px;\n\n}\n\n.payment h3{\n\nfont-size:20px;\n\ncolor:#0F6E56;\n\nmargin-bottom:18px;\n\n}\n\n.payment ul{\n\nmargin-left:20px;\n\nline-height:2;\n\nfont-size:15px;\n\n}\n\n.bank{\n\nmargin-top:30px;\n\ndisplay:grid;\n\ngrid-template-columns:1fr 1fr;\n\ngap:20px;\n\n}\n\n.bank-card{\n\nbackground:#ffffff;\n\nborder:1px solid #e5e5e5;\n\npadding:20px;\n\nborder-radius:12px;\n\n}\n\n.bank-card h4{\n\ncolor:#0F6E56;\n\nmargin-bottom:12px;\n\nfont-size:17px;\n\n}\n\n.bank-card p{\n\nmargin:8px 0;\n\nfont-size:14px;\n\nline-height:1.7;\n\n}\n\n.note{\n\nmargin-top:35px;\n\nbackground:#FFF8E8;\n\nborder-left:5px solid #F4B400;\n\npadding:18px;\n\nborder-radius:10px;\n\nfont-size:14px;\n\nline-height:1.8;\n\n}\n\n.footer{\n\nmargin-top:40px;\n\nbackground:#0F6E56;\n\ncolor:#fff;\n\npadding:35px;\n\ntext-align:center;\n\n}\n\n.footer h3{\n\nfont-size:24px;\n\nmargin-bottom:12px;\n\n}\n\n.footer p{\n\nmargin:8px 0;\n\nfont-size:14px;\n\nopacity:.95;\n\nline-height:1.8;\n\n}\n\n.footer small{\n\ndisplay:block;\n\nmargin-top:20px;\n\nopacity:.75;\n\nfont-size:13px;\n\n}\n\n@media print{\n\nbody{\n\nbackground:#fff;\n\npadding:0;\n\n}\n\n.invoice{\n\nwidth:100%;\n\nbox-shadow:none;\n\nborder-radius:0;\n\n}\n\n}\n</style>\n\n</head>\n<body>\n\n<div class=\"invoice\">\n\n<div class=\"header\">\n\n<div class=\"company\">\n\n<h1>AutoNode Technologies</h1>\n\n<p class=\"tagline\">\n\nAI Automations & AI Agents for Business\n\n</p>\n\n<p>\n📧 contact@yourcompany.example\n</p>\n\n<p>\n🌐 support@yourcompany.example\n</p>\n\n<p>\n📞 +91 90000 00000\n</p>\n\n</div>\n\n<div class=\"invoice-info\">\n\n<div class=\"badge\">\n\nInvoice\n\n</div>\n\n<h2>INVOICE</h2>\n\n<p>\n\n<strong>Invoice No :</strong>\n\n{{ $json.invoice_number }}\n\n</p>\n\n<p>\n\n<strong>Invoice Date :</strong>\n\n{{ $json.Date }}\n\n</p>\n\n<p>\n\n<strong>Due Date :</strong>\n\n{{ $json.Due_Date }}\n\n</p>\n\n</div>\n\n</div>\n\n<div class=\"section\">\n<div class=\"row\">\n\n<div class=\"box\">\n\n<h3>Bill To</h3>\n\n<p><strong>{{ $json.client_name }}</strong></p>\n\n<p>{{ $json.client_email }}</p>\n\n</div>\n\n<div class=\"box\">\n\n<h3>Invoice Details</h3>\n\n<p><strong>Service :</strong> {{ $json.service }}</p>\n\n<p><strong>Status :</strong> Pending</p>\n\n<p><strong>Currency :</strong> INR (₹)</p>\n\n</div>\n\n</div>\n\n<table>\n\n<thead>\n\n<tr>\n\n<th>Description</th>\n\n<th style=\"text-align:center;\">Qty</th>\n\n<th style=\"text-align:right;\">Unit Price</th>\n\n<th style=\"text-align:right;\">Amount</th>\n\n</tr>\n\n</thead>\n\n<tbody>\n\n<tr>\n\n<td>\n\n<strong>{{ $json.service }}</strong>\n\n<br>\n\n<span style=\"font-size:13px;color:#777;\">\n\nProfessional AI Automation & Development Service\n\n</span>\n\n</td>\n\n<td style=\"text-align:center;\">\n\n1\n\n</td>\n\n<td class=\"amount\">\n\n₹ {{ $json.amount }}\n\n</td>\n\n<td class=\"amount\">\n\n₹ {{ $json.amount }}\n\n</td>\n\n</tr>\n\n</tbody>\n\n</table>\n<div class=\"summary\">\n\n<table>\n\n<tr>\n\n<td class=\"label\">\n\nSubtotal\n\n</td>\n\n<td class=\"value\">\n\n₹ {{ $json.amount }}\n\n</td>\n\n</tr>\n\n<tr>\n\n<td class=\"label\">\n\nGST (18%)\n\n</td>\n\n<td class=\"value\">\n\n₹ {{ $json.GST }}\n\n</td>\n\n</tr>\n\n<tr class=\"total-row\">\n\n<td>\n\nGrand Total\n\n</td>\n\n<td style=\"text-align:right;\">\n\n₹ {{ $json.Total }}\n\n</td>\n\n</tr>\n\n</table>\n\n</div>\n\n<div class=\"payment\">\n\n<h3>Payment Terms</h3>\n\n<ul>\n\n<li>Payment is due within 15 days from the invoice date.</li>\n\n<li>Please mention the Invoice Number while making payment.</li>\n\n<li>Late payments may incur additional charges.</li>\n\n<li>This invoice is generated automatically by AutoNode.</li>\n\n</ul>\n\n</div>\n\n<div class=\"bank\">\n\n<div class=\"bank-card\">\n\n<h4>Payment Methods</h4>\n\n<p>✔ Bank Transfer</p>\n\n<p>✔ UPI</p>\n\n<p>✔ NEFT / IMPS / RTGS</p>\n\n</div>\n\n<div class=\"bank-card\">\n\n<h4>Support</h4>\n\n<p>📧 contact@yourcompany.example</p>\n\n<p>📞 +91 90000 00000</p>\n\n<p>AI Automation Support</p>\n\n</div>\n\n</div>\n\n<div class=\"note\">\n\n<strong>Note:</strong>\n\nThank you for choosing <strong>AutoNode Technologies</strong>.\nWe appreciate your business and look forward to working with you again.\n\n</div>\n\n</div>\n\n<div class=\"footer\">\n\n<h3>Thank You ❤️</h3>\n\n<p>AutoNode Technologies</p>\n\n<p>AI Automations & AI Agents for Business</p>\n\n<p>Invoice generated automatically by AutoNode AI.</p>\n\n<small>\n\n© 2026 AutoNode Technologies. All Rights Reserved.\n\n</small>\n\n</div>\n\n</div>\n\n</body>\n\n</html>"
      },
